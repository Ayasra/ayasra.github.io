# Test dependencies. The harnesses under */tools/ need jsdom, which is
# installed locally and must never reach the repo — GitHub Pages walks the
# whole tree, and a node_modules symlink pointing somewhere that does not
# exist on their runner fails the build outright.
node_modules/
node_modules
package-lock.json
package.json

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# editors
.vscode/
.idea/
*.swp

# build leftovers
_site/
.jekyll-cache/
.sass-cache/
__pycache__/
*.pyc
